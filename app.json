{
  "expo": {
    "name": "Leximple",
    "slug": "lingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/leximple-icon.png",
    "scheme": "lingo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/leximple-icon.png",
      "bundleIdentifier": "com.lingo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#245BD6",
        "foregroundImage": "./assets/images/leximple-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lingo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/leximple-icon.png",
      "name": "Leximple",
      "shortName": "Leximple",
      "themeColor": "#245BD6",
      "backgroundColor": "#F7F7F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F2",
          "image": "./assets/images/leximple-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#141A22",
            "image": "./assets/images/leximple-icon.png"
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "baseUrl": "/leximple",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
